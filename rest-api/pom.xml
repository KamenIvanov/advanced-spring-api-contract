<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pe.advanced.api</groupId>
        <artifactId>api-contract-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rest-api</artifactId>
    <packaging>jar</packaging>

    <!--
        The mapper that decides what a price and an instant look like on the wire lives here,
        which is why this module has databind and not only annotations. The way a value is
        rendered is a fact about the API rather than a choice left to each implementation, so
        it belongs in the artifact that publishes the API.
    -->
    <dependencies>
        <dependency>
            <groupId>com.pe.advanced.api</groupId>
            <artifactId>dto</artifactId>
        </dependency>

        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            Databind, not only annotations: this module carries the mapper that decides what a
            price and an instant look like on the wire, which is a fact about the API rather
            than a choice left to each implementation.
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
            The Spring mappings are on the interfaces, so a path and a verb are declared once and
            the openapi module can produce a complete document without a running service. The cost
            is a framework dependency inside a contract, which is stated rather than hidden: this
            is a jar of annotations and types, and nothing here builds a context.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
