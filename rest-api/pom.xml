<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pe.advanced.api</groupId>
        <artifactId>api-contract-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rest-api</artifactId>
    <packaging>jar</packaging>

    <!--
        The Spring mappings live on the interfaces here, so this module depends on spring-web.
        That buys one declaration of a path and a verb instead of two, and it is what lets the
        openapi module generate a complete specification without a running service. The cost is
        a framework dependency in a contract, which is stated rather than hidden.
    -->
    <dependencies>
        <dependency>
            <groupId>com.pe.advanced.api</groupId>
            <artifactId>dto</artifactId>
        </dependency>

        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            Only for the annotations and ProblemDetail: this is a jar of types, not a running
            framework, and nothing here builds a context. It is still a framework in a
            contract, which is the price of declaring each path and verb once.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!--
            Databind, not only annotations: this module carries the mapper that decides what a
            price and an instant look like on the wire, which is a fact about the API rather
            than a choice left to each implementation.
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
